+++ b/runtime/src/platform_android.cpp
@@ -673,8 +673,15 @@
 #if NX_NCE
 static const char* const kDataProbe = "/exefs/main";  // native execution: the player's own exefs
 #else
 static const char* const kDataProbe = "/analysis/main.bin";
 #endif
-static bool has_data(const std::string& root) { return access((root + kDataProbe).c_str(), R_OK) == 0; }
+static bool has_data(const std::string& root) {
+    // P5S is loaded directly from the user's NSP/XCI (NX_NCE). In that mode the
+    // ExeFS is supplied by game_image.cpp, not by a pre-extracted /exefs folder.
+    const char* game_fd = std::getenv("NX_GAME_FD");
+    const char* keys = std::getenv("NX_KEYS");
+    if (game_fd && *game_fd && keys && *keys) return true;
+    return access((root + kDataProbe).c_str(), R_OK) == 0;
+}
 
